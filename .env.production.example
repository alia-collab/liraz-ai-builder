# Production Environment — lirazai.com
# Copy to .env.production.local for local prod testing, or set in Vercel/hosting dashboard.

# ─── Platform Domain ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://lirazai.com
NEXTAUTH_URL=https://lirazai.com
PLATFORM_DOMAIN=lirazai.com
CORS_ALLOWED_ORIGINS=https://lirazai.com,https://www.lirazai.com

# ─── Customer Preview Subdomains ───────────────────────────────────────────────
# Published projects: https://{slug}.preview.lirazai.com
DEPLOY_BASE_DOMAIN=preview.lirazai.com
DEPLOY_SSL_ENABLED=true

# ─── Required (fill before deploy) ─────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
# Optional alias if you prefer Auth.js naming:
# AUTH_SECRET=
ENCRYPTION_KEY=
# Set the same values in Vercel for Production, Preview, and Development.

# ─── Super Admin (run seed once, then remove password from env) ────────────────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="Liraz Admin"

# ─── AI ────────────────────────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── PayPal (Live mode for production — test sandbox first) ────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
PAYPAL_PRODUCT_ID=
PAYPAL_BRAND_NAME="Liraz AI Builder"
PAYPAL_RETURN_URL=https://lirazai.com/dashboard/billing?paypal=return
PAYPAL_CANCEL_URL=https://lirazai.com/dashboard/billing?paypal=cancel

# ─── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Liraz AI Builder <noreply@lirazai.com>"

# ─── Storage (S3/R2) ───────────────────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=lirazai-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Redis (recommended for production) ────────────────────────────────────────
REDIS_URL=

# ─── Firebase Auth ─────────────────────────────────────────────────────────────
# Client keys (Vercel: mark NEXT_PUBLIC_* as Safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Optional. If empty, the server uses NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# ─── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
