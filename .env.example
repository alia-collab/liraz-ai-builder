# ─── App ──────────────────────────────────────────────────────────────────────
# Local: keep localhost. Production (Vercel env only): https://lirazai.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://lirazai.com
NEXT_PUBLIC_APP_NAME="Liraz AI Builder"
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://neondb_owner:npg_LpSTI6mVhDn5@ep-still-waterfall-aypztvkc-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Auth (NextAuth) ──────────────────────────────────────────────────────────
# Local: keep localhost so cookies/callbacks work on this machine.
# Production: set NEXTAUTH_URL=https://lirazai.com in Vercel — do not put secrets here.
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://lirazai.com
NEXTAUTH_SECRET=                          # REQUIRED: openssl rand -base64 32
# AUTH_SECRET is an alias; NextAuth reads NEXTAUTH_SECRET first.
# AUTH_SECRET=

# ─── Firebase Auth (email/password + Google) ─────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Optional. If empty, the server uses NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=


# OAuth — Apple (optional, leave empty to disable)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── PayPal (Sandbox first; switch PAYPAL_MODE=live for production) ───────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_MONTHLY_PLAN_ID=
PAYPAL_YEARLY_PLAN_ID=
PAYPAL_PRODUCT_ID=
PAYPAL_BRAND_NAME="Liraz AI Builder"
# Optional overrides (defaults use NEXT_PUBLIC_APP_URL)
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=

# ─── AI Providers (Anthropic Claude only) ─────────────────────────────────────
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Liraz AI Credits (server-side only; never show Anthropic cost to customers)
# 1000 credits = $1.00 of real Anthropic API cost
LIRAZ_AI_CREDITS_PER_USD=1000
LIRAZ_AI_CREDIT_RESERVE_DEFAULT=500
LIRAZ_AI_CREDITS_PRO_MONTHLY=8000

# ─── Redis (Queue + Rate Limiting) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object Storage (S3-compatible) ───────────────────────────────────────────
S3_ENDPOINT=                              # e.g. https://s3.amazonaws.com or MinIO URL
S3_REGION=us-east-1
S3_BUCKET=liraz-ai-builder
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                            # CDN/public URL prefix

# ─── Email (optional — for verification & notifications) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Liraz AI Builder <noreply@lirazai.com>"

# ─── Deployment ─────────────────────────────────────────────────────────────
# Customer project preview subdomains: {slug}.preview.lirazai.com
# Wildcard DNS for preview is a later Squarespace A/CNAME step — never MX/TXT.
DEPLOY_BASE_DOMAIN=preview.lirazai.com
DEPLOY_SSL_ENABLED=true
# Platform custom domain (informational — set in hosting provider)
PLATFORM_DOMAIN=lirazai.com
# Extra CORS origins (comma-separated). Defaults already include apex + www.
CORS_ALLOWED_ORIGINS=https://lirazai.com,https://www.lirazai.com

# ─── Super Admin Bootstrap (one-time, run seed) ──────────────────────────────
SUPER_ADMIN_EMAIL=                        # Your email for first super admin
SUPER_ADMIN_PASSWORD=                     # Strong password (min 12 chars)
SUPER_ADMIN_NAME="Super Admin"

# ─── Security ─────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                           # REQUIRED for MFA secrets: openssl rand -hex 32
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Feature Flags (override defaults) ────────────────────────────────────────
FEATURE_MAINTENANCE_MODE=false
